# ===== 大模型翻译配置（OpenAI 兼容接口）=====
# 任意 OpenAI 兼容服务均可，例如：
#   智谱 GLM:   https://open.bigmodel.cn/api/paas/v4   模型: glm-4.5-flash
#   DeepSeek:   https://api.deepseek.com               模型: deepseek-chat
#   OpenAI:     https://api.openai.com/v1              模型: gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash

# ===== 翻译服务选择 =====
# openai          使用上面的 OpenAI 兼容配置（正式使用，推荐）
# siliconflowfree 使用 pdf2zh 内置的免费翻译服务（无需 Key，仅供试用，速度/质量有限）
TRANSLATE_SERVICE=openai

# ===== 翻译参数 =====
# 源语言 / 目标语言
TRANSLATE_LANG_IN=en
TRANSLATE_LANG_OUT=zh
# 是否同时生成双语对照版 PDF
ENABLE_DUAL=true
# 翻译请求频率限制（每秒请求数）
TRANSLATE_QPS=4

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000
